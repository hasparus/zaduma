---
/**
 * @file Optimized Image component with placeholder
 *
 * This file started as a "fork" / "eject" of Image from `@astrojs/image`,
 * because I couldn't get its props to expose from an Image component that
 * would compose it.
 *
 * The `@ts-ignore` at the top of the original file didn't add much confidence too.
 *
 * @changes
 * - Added placeholder powered by `plaiceholder` CSS strategy.
 * - Limited the width of the image to wide container width, to get smaller & ligher images.
 *
 * Accepted `src`s:
 * - `ImageMetadata`: imported, e.g. by MDX from `![](./image.png)` next to the post
 * - `/name.png`: from `src/images/`
 * - `https://…`: remote
 * - `/content/…`: from `public/`, served as is in its own aspect ratio
 * - `raw!…`: served as is
 */

import type { GetImageResult, ImageMetadata, ImageTransform } from "astro";
import { getImage, type LocalImageProps } from "astro:assets";
import { readFile } from "node:fs/promises";
import { getPlaiceholder } from "plaiceholder";
import sharp from "sharp";

import "./Image.css";

// No image needs to be wider than this.
// TODO: Support High DPI screens by ensuring Astro emits images 2x of that.
const WIDE_CONTAINER_WIDTH = 774;

export type Props = Omit<LocalImageProps, "src" | "height"> & {
  src: LocalImageProps["src"] | string;
  aspectRatio?: number | string;
  height?: number | string;
};

type Source =
  | { optimize: true; image: ImageMetadata | string; bytes: Buffer }
  | { optimize: false; src: string; intrinsic?: ImageMetadata };

const srcImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/**/*.{avif,gif,jpeg,jpg,png,svg,webp}",
);
const publicImages = import.meta.glob<{ default: ImageMetadata }>(
  "/public/content/**/*.{avif,gif,jpeg,jpg,png,svg,webp}",
);

const {
  loading = "lazy",
  decoding = "async",
  alt = "",
  src: srcProp,
  aspectRatio: aspectRatioProp,
  ...props
} = Astro.props as Props;

const source = await resolveSource(srcProp);

let { width, height } = props;
let aspectRatio = aspectRatioProp;
let placeholder: Awaited<ReturnType<typeof getPlaiceholder>>["css"] | null =
  null;

if (source.optimize) {
  const { metadata, css } = await getPlaiceholder(source.bytes, { size: 10 });
  // A blurred placeholder would show through transparent pixels.
  const { isOpaque } = await sharp(source.bytes).stats();
  if (isOpaque) placeholder = css;

  if (!width && !height && !aspectRatio) {
    width = Math.min(metadata.width, WIDE_CONTAINER_WIDTH);
    aspectRatio = metadata.width / metadata.height;
    height = Math.round(width / aspectRatio);
  }
} else if (source.intrinsic) {
  // Raw images can contain text or important details that shouldn't be cut
  // off, so they keep their own aspect ratio.
  const ratio = source.intrinsic.width / source.intrinsic.height;
  height = Number(width) / Number(aspectRatio);
  width = height * ratio;
  aspectRatio = ratio;
}

height ??=
  typeof aspectRatio === "number" ? Number(width) / aspectRatio : undefined;

const { src, attributes }: Pick<GetImageResult, "src" | "attributes"> =
  source.optimize
    ? await getImage({
        ...props,
        src: source.image,
        format: "webp",
        width,
        height,
      } as ImageTransform)
    : { src: source.src, attributes: {} };
const { class: className, ...imgAttributes } = attributes;

async function resolveSource(src: Props["src"]): Promise<Source> {
  const resolved = await src;
  if (typeof resolved === "object") {
    const image = "default" in resolved ? resolved.default : resolved;
    return { optimize: true, image, bytes: await readImported(image) };
  }

  if (resolved.startsWith("http")) {
    const res = await fetch(resolved);
    if (!res.ok) {
      throw new Error(
        `Failed to fetch image ${resolved}: ${res.status} ${res.statusText}`,
      );
    }
    const bytes = Buffer.from(await res.arrayBuffer());
    return { optimize: true, image: resolved, bytes };
  }

  const raw = resolved.replace(/^raw!/, "");
  if (raw.startsWith("/content/")) {
    const [path] = raw.split("?");
    const intrinsic = await load(publicImages, `/public${path}`);
    return { optimize: false, src: raw, intrinsic };
  }
  if (raw !== resolved) return { optimize: false, src: raw };

  if (resolved.startsWith("/")) {
    const image = await load(srcImages, `/src/images${resolved}`);
    return { optimize: true, image, bytes: await readImported(image) };
  }

  throw new Error(
    `Unsupported image src "${resolved}". Use an image imported next to the post, a path in src/images/ or public/content/, or a URL.`,
  );
}

async function load(
  glob: Record<string, () => Promise<{ default: ImageMetadata }>>,
  key: string,
) {
  const importImage = glob[decodeURIComponent(key)];
  if (!importImage) throw new Error(`Image ${key} not found`);
  const { default: image } = await importImage();
  return image;
}

/** Astro attaches the source path to imported images, but leaves it out of `ImageMetadata`'s type. */
function readImported(image: ImageMetadata & { fsPath?: string }) {
  if (!image.fsPath) {
    throw new Error(
      `Image ${image.src} has no fsPath to read a placeholder from`,
    );
  }
  return readFile(image.fsPath);
}
---

<span
  zaduma-image
  class:list={[
    "zaduma-image-box relative block overflow-hidden",
    !placeholder &&
      "inline-flex! w-(--wide-content-width) justify-center bg-current/10 [&>img]:h-full [&>img]:object-contain",
  ]}
>
  <img
    {...{ src, width, height, alt, loading, decoding, ...imgAttributes }}
    class:list={["rounded-xs dark:opacity-80", className]}
  />
  {
    placeholder && (
      <span
        style={placeholder}
        class="absolute inset-0 -z-10 h-full w-full scale-150 transform blur-2xl filter dark:opacity-80"
      />
    )
  }
</span>
