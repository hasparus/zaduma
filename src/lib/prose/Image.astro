---
/**
 * @file Optimized Image component with placeholder
 *
 * This file started as a "fork" / "eject" of Image from `@astrojs/image`,
 * because I couldn't get its props to expose from an Image component that
 * would compose it.
 *
 * The `@ts-ignore` at the top of the original file didn't add much confidence too.
 *
 * @changes
 * - Added placeholder powered by `plaiceholder` CSS strategy.
 * - Limited the width of the image to wide container width, to get smaller & ligher images.
 */

import type { ImageMetadata, ImageTransform } from "astro";
import {
  getImage,
  type LocalImageProps,
  type RemoteImageProps,
} from "astro:assets";
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { getPlaiceholder } from "plaiceholder";

import { resolvePostImage } from "../postImages";

import "./Image.css";

// All* images with `src`s starting from / are imported from `src/images/` folder.
const SRC_IMAGES_PREFIX = "/";

// Images with `src` starting with /content/ live in public dir.
const PUBLIC_IMAGES_PREFIX = "/content/";

// No image needs to be wider than this.
// TODO: Support High DPI screens by ensuring Astro emits images 2x of that.
const WIDE_CONTAINER_WIDTH = 774;

type LocalProps = LocalImageProps & {
  aspectRatio?: number | string;
  height?: number | string;
};
type RemoteProps = RemoteImageProps & {
  aspectRatio?: number | string;
  height?: number | string;
};
export type Props = (LocalProps | RemoteProps) & {
  /** Path of the post's `.mdx` file. Enables `src="./image.png"` colocated with the post. */
  relativeTo?: string;
};

const {
  loading = "lazy",
  decoding = "async",
  relativeTo,
  ...props
} = Astro.props as Props;

let width = props.width;
let height = props.height;

// Colocated with the post: imported by MDX from `![](./image.png)`, or a `./` path.
let importedImage: (ImageMetadata & { fsPath?: string }) | null = null;
let fsPath: string | undefined;

const srcProp = await props.src;
if (typeof srcProp === "object") {
  importedImage = "default" in srcProp ? srcProp.default : srcProp;
  fsPath = importedImage.fsPath;
} else if (srcProp.startsWith(".")) {
  if (!relativeTo) {
    throw new Error(`Relative image src "${srcProp}" requires relativeTo`);
  }
  ({ image: importedImage, fsPath } = await resolvePostImage(
    relativeTo,
    srcProp,
  ));
}
let src = importedImage?.src ?? (srcProp as string);

const pathToImage = decodeURIComponent(
  src.startsWith(SRC_IMAGES_PREFIX)
    ? `../../../src/images${src.slice(SRC_IMAGES_PREFIX.length - 1)}`
    : src,
);

let placeholder: null | {
  backgroundImage: string;
  backgroundPosition: string;
  backgroundSize: string;
  backgroundRepeat: string;
} = null;

const isRaw = src.startsWith("raw!") || src.startsWith(PUBLIC_IMAGES_PREFIX);
if (isRaw) {
  src = src.slice(4);

  if (src.startsWith(PUBLIC_IMAGES_PREFIX)) {
    const globbed = import.meta.glob<false, string, { default: ImageMetadata }>(
      "../../../public/content/**/*.{avif,gif,jpeg,jpg,png,svg,webp}",
    );
    const path = "../../../public" + src;
    const importedModule = await globbed[path]!();
    const imported = importedModule.default;

    // I'm preserving the aspect ratio of the imported image, because
    // the 'raw' images can contain text or important details that should
    // not be cut off.
    height =
      Number.parseFloat(props.width as string) /
      Number.parseFloat(props.aspectRatio as string);
    props.aspectRatio = imported.width / imported.height;
    width = height * (imported.width / imported.height);
  }
} else {
  if (!importedImage && src.startsWith(SRC_IMAGES_PREFIX)) {
    src = src.slice(SRC_IMAGES_PREFIX.length - 1);
    const allImages = import.meta.glob<
      false,
      string,
      { default: ImageMetadata }
    >("../../../src/images/**/*");

    try {
      const importedModule =
        await allImages[pathToImage.replace("../src/", "")]!();
      importedImage = importedModule.default;
    } catch (error) {
      console.error({ availableImages: Object.keys(allImages), pathToImage });
      throw error;
    }
  }
  if (importedImage) {
    props.width ??= importedImage.width;
    props.height ??= importedImage.height;
    if (importedImage.format === "jpg") {
      importedImage.format = "webp";
    }
  }

  let imageForPlaceholder: Buffer;
  if (fsPath) {
    imageForPlaceholder = await readFile(fsPath);
  } else if (pathToImage.startsWith("http")) {
    const res = await fetch(pathToImage);
    if (!res.ok) {
      throw new Error(
        `Failed to fetch image ${pathToImage}: ${res.status} ${res.statusText}`,
      );
    }
    imageForPlaceholder = Buffer.from(await res.arrayBuffer());
  } else {
    // Resolve the source image from the project root. `pathToImage` is
    // relative to this component (`../../../src/images/...`); strip the
    // leading `../` segments and join onto cwd so the lookup is independent
    // of Astro's emitted chunk layout (which changed in Astro 6).
    imageForPlaceholder = await readFile(
      join(process.cwd(), pathToImage.replace(/^(?:\.\.\/)+/, "")),
    );
  }

  const { metadata, css } = await getPlaiceholder(imageForPlaceholder, {
    size: 10,
  });
  placeholder = css;

  if (!width && !height && !props.aspectRatio) {
    width ??= metadata.width;
    props.aspectRatio ??= metadata.width / metadata.height;
    width = Math.min(width, WIDE_CONTAINER_WIDTH);
    height = Math.round(width / Number.parseFloat(props.aspectRatio as string));
  }
}

height ??=
  typeof props.aspectRatio === "number"
    ? Number.parseFloat(width as unknown as string) / props.aspectRatio
    : undefined;

props.alt ||= "";
let attrs = { src, class: "", width, height, aspectRatio: props.aspectRatio };

if (!isRaw) {
  let attributes;
  props.src = src;
  ({ src, attributes } = await getImage({
    ...props,
    src: importedImage || src,
    format: "webp",
    width,
    height,
  } as ImageTransform));
  attrs = { ...attrs, ...attributes, src };
}
---

<span
  zaduma-image
  class:list={[
    "zaduma-image-box relative block overflow-hidden",
    !placeholder &&
      "inline-flex! w-(--wide-content-width) justify-center bg-current/10 [&>img]:h-full [&>img]:object-contain",
  ]}
>
  <img
    {...attrs}
    class:list={["rounded-xs dark:opacity-80", attrs.class]}
    loading={loading}
    decoding={decoding}
  />
  {
    placeholder && (
      <span
        style={placeholder}
        class="absolute inset-0 -z-10 h-full w-full scale-150 transform blur-2xl filter dark:opacity-80"
      />
    )
  }
</span>
